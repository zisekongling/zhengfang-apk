<!-- 组件选择器静态预览用的课程卡：淡底与左侧色条合在一张图里，运行时卡片由代码按课程色着色。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E7F6F8" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:start="10dp" android:top="9dp" android:bottom="9dp" android:width="3dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#22A7B5" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</layer-list>
