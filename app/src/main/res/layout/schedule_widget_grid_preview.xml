<?xml version="1.0" encoding="utf-8"?>
<!-- 系统小组件选择器里的静态预览（previewLayout）：示例四门课，按时间先左列、后右列排列。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/schedule_widget_outline" android:clipToOutline="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/schedule_widget_light">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="6dp">
        <TextView style="@style/ScheduleWidgetMetadata" android:layout_width="0dp" android:layout_weight="1"
            android:textSize="14sp" android:textStyle="bold" android:textColor="#1D2433"
            android:text="@string/schedule_widget_grid_preview_heading" />
        <TextView style="@style/ScheduleWidgetMetadata" android:layout_width="wrap_content" android:layout_marginStart="8dp"
            android:textSize="12sp" android:text="@string/schedule_widget_grid_preview_count" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal" android:baselineAligned="false"
        android:divider="@drawable/schedule_widget_grid_gap" android:showDividers="middle">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:divider="@drawable/schedule_widget_grid_gap" android:showDividers="middle">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="8dp"
                android:background="@drawable/schedule_widget_grid_preview_blue">
                <TextView style="@style/ScheduleWidgetMetadata" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="#1D2433" android:text="@string/schedule_widget_grid_preview_name_1" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:orientation="horizontal">
                    <TextView style="@style/ScheduleWidgetMetadata" android:layout_width="wrap_content"
                        android:text="@string/schedule_widget_grid_preview_time_1" />
                    <TextView style="@style/ScheduleWidgetMetadata" android:layout_width="0dp" android:layout_weight="1"
                        android:paddingStart="6dp" android:text="@string/schedule_widget_grid_preview_room_1" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="8dp"
                android:background="@drawable/schedule_widget_grid_preview_teal">
                <TextView style="@style/ScheduleWidgetMetadata" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="#1D2433" android:text="@string/schedule_widget_grid_preview_name_2" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:orientation="horizontal">
                    <TextView style="@style/ScheduleWidgetMetadata" android:layout_width="wrap_content"
                        android:text="@string/schedule_widget_grid_preview_time_2" />
                    <TextView style="@style/ScheduleWidgetMetadata" android:layout_width="0dp" android:layout_weight="1"
                        android:paddingStart="6dp" android:text="@string/schedule_widget_grid_preview_room_2" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:orientation="vertical" android:divider="@drawable/schedule_widget_grid_gap" android:showDividers="middle">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="8dp"
                android:background="@drawable/schedule_widget_grid_preview_green">
                <TextView style="@style/ScheduleWidgetMetadata" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="#1D2433" android:text="@string/schedule_widget_grid_preview_name_3" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:orientation="horizontal">
                    <TextView style="@style/ScheduleWidgetMetadata" android:layout_width="wrap_content"
                        android:text="@string/schedule_widget_grid_preview_time_3" />
                    <TextView style="@style/ScheduleWidgetMetadata" android:layout_width="0dp" android:layout_weight="1"
                        android:paddingStart="6dp" android:text="@string/schedule_widget_grid_preview_room_3" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="8dp"
                android:background="@drawable/schedule_widget_grid_preview_red">
                <TextView style="@style/ScheduleWidgetMetadata" android:textSize="14sp" android:textStyle="bold"
                    android:textColor="#1D2433" android:text="@string/schedule_widget_grid_preview_name_4" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:orientation="horizontal">
                    <TextView style="@style/ScheduleWidgetMetadata" android:layout_width="wrap_content"
                        android:text="@string/schedule_widget_grid_preview_time_4" />
                    <TextView style="@style/ScheduleWidgetMetadata" android:layout_width="0dp" android:layout_weight="1"
                        android:paddingStart="6dp" android:text="@string/schedule_widget_grid_preview_room_4" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
