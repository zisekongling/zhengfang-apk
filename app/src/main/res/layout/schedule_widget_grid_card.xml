<?xml version="1.0" encoding="utf-8"?>
<!-- 网格课程卡：课程色淡底 + 左侧色条 + 课名 / 时间与地点。只用平台 View，桌面进程可直接 inflate。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_course" android:layout_width="0dp" android:layout_height="wrap_content"
    android:layout_weight="1">
    <ImageView android:id="@+id/widget_grid_card" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/schedule_widget_grid_card" android:scaleType="fitXY"
        android:contentDescription="@null" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_grid_content" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <ImageView android:id="@+id/widget_grid_bar" android:layout_width="3dp" android:layout_height="match_parent"
            android:src="@drawable/schedule_widget_grid_bar" android:scaleType="fitXY"
            android:contentDescription="@null" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:orientation="vertical">
            <TextView android:id="@+id/widget_name" style="@style/ScheduleWidgetCourseName" android:textSize="15sp"
                android:text="@string/schedule_widget_preview" />
            <TextView android:id="@+id/widget_teacher" style="@style/ScheduleWidgetFullText" android:layout_marginTop="2dp"
                android:visibility="gone" />
            <TextView android:id="@+id/widget_time" style="@style/ScheduleWidgetMetadata" android:layout_marginTop="3dp"
                android:visibility="gone" />
            <LinearLayout android:id="@+id/widget_grid_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:orientation="horizontal">
                <TextView android:id="@+id/widget_grid_time" style="@style/ScheduleWidgetMetadata" android:layout_width="wrap_content"
                    android:text="@string/schedule_widget_preview_time" />
                <TextView android:id="@+id/widget_location" style="@style/ScheduleWidgetFullText" android:layout_width="0dp"
                    android:layout_weight="1" android:paddingStart="6dp" android:text="@string/schedule_widget_preview_room" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
